# Pooled connection (used by the running app). On Neon this is the "-pooler" host.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Direct (non-pooled) connection, used by Prisma for migrations.
# On Neon this is the same host WITHOUT "-pooler".
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Secret used to sign JWTs. Set a strong random value in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: enable real AI features (evening brain-dump, daily summary, plan-tomorrow).
# Leave all unset to use the offline heuristic engine.
# Provider precedence: OpenAI is used if set, otherwise Anthropic.
#
# OpenAI (or any OpenAI-compatible gateway, e.g. bazaarlink.ai / OpenRouter / local proxy):
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"          # a model the endpoint offers
# OPENAI_BASE_URL="https://api.openai.com/v1"   # override to point at a compatible gateway's /v1 endpoint
# OPENAI_JSON_MODE="true"             # force JSON mode on/off; auto-on only for official OpenAI
#
# Anthropic (alternative):
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-5"

# Optional: enable "Continue with Google". Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID on the web app.
# GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"

PORT=4000
WEB_ORIGIN="http://localhost:3000"
