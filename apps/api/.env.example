# Pooled connection (used by the running app). On Neon this is the "-pooler" host.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Direct (non-pooled) connection, used by Prisma for migrations.
# On Neon this is the same host WITHOUT "-pooler".
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Secret used to sign JWTs. Set a strong random value in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: enable real Claude AI features. Leave unset to use the heuristic engine.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-5"

# Optional: enable "Continue with Google". Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID on the web app.
# GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"

PORT=4000
WEB_ORIGIN="http://localhost:3000"
